import urllib.request                                    # 웹 요청 라이브러리
import json                                              # JSON 데이터 처리 라이브러리
import datetime                                          # 날짜/시간 라이브러리
import asyncio                                           # 비동기 실행 라이브러리
from telegram import Bot                                 # 텔레그램 봇 객체

telegram_id = '8359564882'                  # 내 텔레그램 chat_id
my_token = '8645760044:AAFfjWh4UI25Y6D9ZYh1jM1z04NhTCSrdwQ' # 발급받은 봇 토큰
api_key = '2010f09c53bcfa6ad82346e6c0a9ddc7'             # 날씨 API 키
bot = Bot(token=my_token)                                # 봇 객체 생성

ALERT_HOURS = [7, 10, 13, 16, 19, 22]                    # 정각 알림 시간 목록
ALERT_TIMES = ["08:30", "14:45"]                         # 특정 지정 시간 알림 목록

def getWeather():                                        # 날씨 정보를 가져오는 함수
    url = f"https://api.openweathermap.org/data/2.5/forecast?q=Seoul&appid={api_key}&units=metric&lang=kr&cnt=8"
    with urllib.request.urlopen(url) as r:               # API 요청 송신
        data = json.loads(r.read())                      # 응답 데이터 변환
        text = ""                                        # 텍스트 초기화
        for i in range(8):                               # 8개 예보 데이터 순회
            item = data['list'][i]                       # 개별 데이터 추출
            hour = str((int(item['dt_txt'][11:13]) + 9) % 24).zfill(2) # 한국 시간 변환
            temp = item['main']['temp']                  # 기온 추출
            humi = item['main']['humidity']              # 습도 추출
            desc = item['weather'][0]['description']     # 날씨 설명 추출
            text += f"({hour}시 {temp}도 {humi}% {desc})\n" # 문자열 생성
    return text                                          # 결과 반환

async def main():                                        # 메인 비동기 함수
    try:                                                 # 예외 처리 시작
        while True:                                      # 무한 반복
            now = datetime.datetime.now()                # 현재 시간 조회
            hm = now.strftime('%H:%M')                   # 시간 분 포맷팅
            is_alert_hour = now.hour in ALERT_HOURS and now.minute == 0 and now.second == 0 # 정각 확인
            is_alert_time = hm in ALERT_TIMES and now.second == 0 # 지정 시간 확인
            if is_alert_hour or is_alert_time:           # 조건 충족 시
                msg = getWeather()                       # 날씨 정보 획득
                print(msg)                               # 콘솔 출력
                await bot.send_message(chat_id=telegram_id, text=msg) # 텔레그램 전송
            await asyncio.sleep(1)                       # 1초 대기
    except KeyboardInterrupt:                            # 종료 신호 시
        pass                                             # 무시 및 종료

if __name__ == "__main__":                               # 실행 시점 확인
    asyncio.run(main())                                  # 함수 실행
